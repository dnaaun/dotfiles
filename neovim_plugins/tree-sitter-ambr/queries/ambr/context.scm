; nvim-treesitter-context: which ancestors to pin at the top of the window.
; The snapshot shows its `# name: ...` line, the containers their opening
; line, and a pair/attribute the `'key': dict({` line, which is what tells you
; where in the snapshot you are.
[
  (snapshot)
  (dict)
  (set)
  (list)
  (tuple)
  (object)
  (pair)
  (attribute)
] @context
