{
  "permissions": {
    "allow": [
      "WebFetch(domain:nvim-orgmode.github.io)",
      "WebFetch(domain:neovim.io)",
      "Bash(file:*)",
      "Bash(chmod:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-tmux-flash start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-tmux-flash stop"
          }
        ]
      }
    ]
  }
}
