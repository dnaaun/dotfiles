#!/usr/bin/env -S cargo +nightly -Zscript --quiet
---
[package]
name = "jj_squash_onto_parents"
edition = "2024"

[dependencies]
anyhow = "1"
---
//! Squash every commit selected by REVSET into its parent, keeping the parent's message.
//!
//! One `jj log` (which snapshots the working copy) lists the selection in topological order,
//! children before parents, so squashing in that order is always leaf-first. Merge commits and
//! the root commit are rejected up front. Total: 1 + N jj invocations.

use std::process::{Command, Stdio};

use anyhow::{Context, Result, bail, ensure};

struct Change {
    change_id: String,
    parents: usize,
    is_root: bool,
}

fn main() {
    if let Err(e) = real_main() {
        eprintln!("error: {e:#}");
        std::process::exit(1);
    }
}

fn real_main() -> Result<()> {
    let args: Vec<String> = std::env::args().skip(1).collect();
    let [revset] = args.as_slice() else {
        eprintln!("Usage: jj_squash_onto_parents REVSET");
        std::process::exit(2);
    };

    let out = Command::new("jj")
        .args(["log", "--no-graph", "-r", revset, "-T"])
        .arg(r#"change_id ++ "\x1f" ++ parents.len() ++ "\x1f" ++ root ++ "\n""#)
        .stderr(Stdio::inherit())
        .output()
        .context("failed to spawn jj")?;
    ensure!(out.status.success(), "jj log failed ({})", out.status);

    let mut changes = Vec::new();
    for line in String::from_utf8(out.stdout)?
        .lines()
        .filter(|l| !l.is_empty())
    {
        let [change_id, parents, is_root] = line.split('\x1f').collect::<Vec<_>>()[..] else {
            bail!("unexpected jj log line: {line:?}");
        };
        changes.push(Change {
            change_id: change_id.to_string(),
            parents: parents.parse().context("parents.len()")?,
            is_root: is_root == "true",
        });
    }

    if changes.is_empty() {
        eprintln!("The revset selected no commits");
        return Ok(());
    }
    let merges: Vec<&str> = changes
        .iter()
        .filter(|c| c.parents > 1)
        .map(|c| c.change_id.as_str())
        .collect();
    if !merges.is_empty() {
        bail!(
            "Cannot squash merge commits selected by {revset:?}:\n{}",
            merges.join("\n")
        );
    }
    if let Some(root) = changes.iter().find(|c| c.is_root) {
        bail!(
            "Cannot squash the repository root commit:\n{}",
            root.change_id
        );
    }

    for change in &changes {
        let status = Command::new("jj")
            .args([
                "squash",
                "--revision",
                &change.change_id,
                "--use-destination-message",
            ])
            .status()
            .context("failed to spawn jj squash")?;
        ensure!(
            status.success(),
            "jj squash {} failed ({status})",
            change.change_id
        );
    }
    Ok(())
}
