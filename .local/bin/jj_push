#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <change>"
    exit 1
fi

change="$1"

mapfile -t bookmarks < <(
    jj log \
        --no-graph \
        --reversed \
        -r "::$change ~ ::main" \
        -T 'local_bookmarks.map(|bookmark| bookmark.name() ++ "\n").join("")'
)

for bookmark in "${bookmarks[@]}"; do
    jj git push --ignore-immutable --bookmark "$bookmark"
done
