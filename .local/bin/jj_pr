#!/usr/bin/env -S cargo +nightly -Zscript --quiet
---
[package]
name = "jj_pr"
edition = "2024"

[dependencies]
anyhow = "1"
clap = { version = "4", features = ["derive", "env"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
---
//! Create (or edit) a GitHub PR for a single jj revision.
//!
//! 1. Resolve `-r` to exactly one revision (the head). The base is the closest bookmarked
//!    ancestor. Head, base and every commit in between are loaded with ONE `jj log` call.
//! 2. If the head has no bookmark, create `dt/<slugified title>` (same scheme as `jj_bkmark`).
//! 3. Push head/base bookmarks if they are out of date on the remote.
//! 4. Look up the open PRs for head and base with ONE GraphQL query.
//! 5. Open nvim to edit "<title>\n\n<body>" (body prefilled with pull_request_template.md).
//! 6. Create the PR, or edit the existing open PR with the same head+base.
//!
//! Only the first `jj` call snapshots the working copy; every other one passes
//! `--ignore-working-copy`, which is the expensive part of a `jj` invocation in a big repo.
//! All `gh` invocations run with GIT_DIR=$(jj git root) so this works in jj workspaces.

use std::env;
use std::ffi::OsStr;
use std::fs;
use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};

use anyhow::{Context, Result, anyhow, bail, ensure};
use clap::Parser;
use serde::Deserialize;

const SCISSORS: &str = "# ------------------------ >8 ------------------------";

#[derive(Parser, Debug)]
#[command(about = "Create or edit a GitHub PR for one jj revision")]
struct Args {
    /// Revset that must resolve to exactly one revision (the PR head).
    #[arg(short, long)]
    revision: String,

    /// Create the PR as a draft (ignored when editing an existing PR).
    #[arg(short, long)]
    draft: bool,

    /// Editor to use (defaults to nvim).
    #[arg(long, env = "JJ_PR_EDITOR", default_value = "nvim")]
    editor: String,
}

fn run(cmd: &mut Command) -> Result<String> {
    let rendered = format!("{cmd:?}");
    let out = cmd
        .stderr(Stdio::inherit())
        .output()
        .with_context(|| format!("failed to spawn {rendered}"))?;
    ensure!(
        out.status.success(),
        "command failed ({}): {rendered}",
        out.status
    );
    Ok(String::from_utf8(out.stdout)?)
}

/// A `jj` call that snapshots the working copy. Use exactly once, before anything else.
fn jj_snapshot(args: &[&str]) -> Result<String> {
    run(Command::new("jj").args(args))
}

/// A `jj` call that skips the working-copy snapshot. Safe for reads and for operations that
/// do not touch the working-copy commit (bookmark create, git push).
fn jj(args: &[&str]) -> Result<String> {
    run(Command::new("jj").arg("--ignore-working-copy").args(args))
}

fn lines(s: &str) -> Vec<String> {
    s.lines()
        .map(str::trim)
        .filter(|l| !l.is_empty())
        .map(String::from)
        .collect()
}

fn gh(git_dir: &Path, args: &[&str]) -> Result<String> {
    run(Command::new("gh").env("GIT_DIR", git_dir).args(args))
}

#[derive(Debug, PartialEq, Eq, Clone, Copy)]
enum Role {
    Head,
    Base,
    Mid,
}

#[derive(Debug)]
struct Rev {
    role: Role,
    commit_id: String,
    local_bookmarks: Vec<String>,
    /// `name@remote` for every remote bookmark pointing at exactly this commit.
    remote_bookmarks: Vec<String>,
    description: String,
}

impl Rev {
    fn title(&self) -> &str {
        self.description.lines().next().unwrap_or("").trim()
    }

    fn body(&self) -> &str {
        self.description
            .split_once('\n')
            .map(|(_, b)| b.trim())
            .unwrap_or("")
    }
}

/// Escape a revset so it can be embedded inside a template string literal.
fn template_str(s: &str) -> String {
    s.replace('\\', "\\\\").replace('"', "\\\"")
}

/// Head, base, and everything in between, in `jj log` order (children before parents), from a
/// single `jj log`. This is the one call that snapshots the working copy.
fn load_revs(revision: &str) -> Result<Vec<Rev>> {
    let base_revset = format!("heads(::({revision})- & bookmarks())");
    // `::head & base::` is the PR's commits plus the base itself; if there is no bookmarked
    // ancestor that term is empty and we still get the head back so we can report it.
    let revset = format!("({revision}) | (::({revision}) & ({base_revset})::)");
    let template = format!(
        concat!(
            r#"if(self.contained_in("{head}"), "head", if(self.contained_in("{base}"), "base", "mid"))"#,
            r#" ++ "\x1f" ++ commit_id"#,
            r#" ++ "\x1f" ++ local_bookmarks.map(|b| b.name()).join("\x1e")"#,
            r#" ++ "\x1f" ++ remote_bookmarks.map(|b| b.name() ++ "@" ++ b.remote()).join("\x1e")"#,
            r#" ++ "\x1f" ++ description ++ "\0""#,
        ),
        head = template_str(revision),
        base = template_str(&base_revset),
    );
    let out = jj_snapshot(&["log", "--no-graph", "-r", &revset, "-T", &template])?;

    let mut revs = Vec::new();
    for record in out.split('\0').filter(|r| !r.is_empty()) {
        let fields: Vec<&str> = record.splitn(5, '\x1f').collect();
        let [role, commit_id, local, remote, description] = fields.as_slice() else {
            bail!("unexpected jj log record: {record:?}");
        };
        let role = match *role {
            "head" => Role::Head,
            "base" => Role::Base,
            "mid" => Role::Mid,
            other => bail!("unexpected role {other:?}"),
        };
        let split = |s: &str| -> Vec<String> {
            s.split('\x1e')
                .filter(|s| !s.is_empty())
                .map(String::from)
                .collect()
        };
        revs.push(Rev {
            role,
            commit_id: commit_id.to_string(),
            local_bookmarks: split(local),
            remote_bookmarks: split(remote),
            description: description.to_string(),
        });
    }

    let count = |role| revs.iter().filter(|r| r.role == role).count();
    match count(Role::Head) {
        1 => {}
        0 => bail!("revset {revision:?} resolved to no revisions"),
        n => bail!("revset {revision:?} must resolve to exactly one revision, got {n}"),
    }
    match count(Role::Base) {
        1 => {}
        0 => bail!("no bookmarked ancestor of {revision:?} found"),
        n => {
            let bases: Vec<&str> = revs
                .iter()
                .filter(|r| r.role == Role::Base)
                .map(|r| r.commit_id.as_str())
                .collect();
            bail!(
                "ambiguous base: {n} bookmarked ancestors are heads of ::({revision})-: {}",
                bases.join(", ")
            );
        }
    }
    Ok(revs)
}

fn pick_bookmark(what: &str, bookmarks: &[String]) -> Result<String> {
    match bookmarks {
        [b] => Ok(b.clone()),
        [b, ..] => {
            eprintln!(
                "note: {what} has several bookmarks ({}); using {b}",
                bookmarks.join(", ")
            );
            Ok(b.clone())
        }
        [] => bail!("{what} has no bookmark"),
    }
}

/// Same scheme as `jj_bkmark`: `dt/<first description line, non-letters replaced by _>`.
fn bookmark_name_for(head: &Rev) -> Result<String> {
    let slug: String = head
        .title()
        .chars()
        .map(|c| if c.is_ascii_alphabetic() { c } else { '_' })
        .collect();
    ensure!(
        !slug.is_empty(),
        "{} has an empty description; cannot derive a bookmark name",
        head.commit_id
    );
    Ok(format!("dt/{slug}"))
}

fn head_bookmark(head: &Rev) -> Result<String> {
    if head.local_bookmarks.is_empty() {
        let name = bookmark_name_for(head)?;
        eprintln!("no bookmark on {}; creating {name}", head.commit_id);
        jj(&["bookmark", "create", &name, "-r", &head.commit_id])?;
        return Ok(name);
    }
    pick_bookmark("head revision", &head.local_bookmarks)
}

struct Remote {
    name: String,
    owner: String,
    repo: String,
}

/// Prefer `origin`; otherwise the first remote. Owner/repo are parsed from the URL so we never
/// need `gh repo view` (a network round trip).
fn git_remote() -> Result<Remote> {
    let remotes: Vec<(String, String)> = lines(&jj(&["git", "remote", "list"])?)
        .into_iter()
        .filter_map(|l| {
            let mut it = l.split_whitespace();
            Some((it.next()?.to_string(), it.next()?.to_string()))
        })
        .collect();
    let (name, url) = remotes
        .iter()
        .find(|(n, _)| n == "origin")
        .or_else(|| remotes.first())
        .cloned()
        .ok_or_else(|| anyhow!("no git remotes configured"))?;
    // Handles git@github.com:owner/repo.git, ssh://git@github.com/owner/repo.git,
    // https://github.com/owner/repo(.git), and bare github.com/owner/repo.
    let trimmed = url.trim_end_matches('/').trim_end_matches(".git");
    let mut segs = trimmed.rsplit(['/', ':']).filter(|s| !s.is_empty());
    let (repo, owner) = (segs.next(), segs.next());
    let (Some(repo), Some(owner)) = (repo, owner) else {
        bail!("could not parse owner/repo from remote url {url:?}");
    };
    Ok(Remote {
        name,
        owner: owner.to_string(),
        repo: repo.to_string(),
    })
}

fn revset_nonempty(revset: &str) -> Result<bool> {
    Ok(!lines(&jj(&[
        "log",
        "--no-graph",
        "-r",
        revset,
        "-T",
        r#"commit_id ++ "\n""#,
    ])?)
    .is_empty())
}

/// Push whichever of head/base is out of date on the remote. The head must be pushed at exactly
/// its local commit; the base only needs to exist on the remote (we never want to force-push
/// trunk from here).
fn ensure_pushed(
    head_rev: &Rev,
    head: &str,
    base_rev: &Rev,
    base: &str,
    remote: &str,
) -> Result<()> {
    let mut stale = Vec::new();
    if !head_rev
        .remote_bookmarks
        .iter()
        .any(|b| b == &format!("{head}@{remote}"))
    {
        stale.push(head);
    }
    // Fast path: the remote bookmark points at the base commit itself (the usual case for a
    // synced trunk). Otherwise ask jj whether it exists anywhere.
    let base_on_commit = base_rev
        .remote_bookmarks
        .iter()
        .any(|b| b == &format!("{base}@{remote}"));
    if !base_on_commit
        && !revset_nonempty(&format!(
            r#"remote_bookmarks(exact:"{base}", remote=exact:"{remote}")"#
        ))?
    {
        stale.push(base);
    }
    if stale.is_empty() {
        return Ok(());
    }
    eprintln!(
        "pushing out-of-date bookmark(s) to {remote}: {}",
        stale.join(", ")
    );
    let mut cmd = Command::new("jj");
    cmd.args([
        "--ignore-working-copy",
        "git",
        "push",
        "--ignore-immutable",
        "--remote",
        remote,
    ]);
    for b in &stale {
        cmd.args(["--bookmark", b]);
    }
    cmd.stdout(Stdio::inherit());
    run(&mut cmd)?;
    Ok(())
}

#[derive(Deserialize, Debug)]
#[serde(rename_all = "camelCase")]
struct Pr {
    number: u64,
    url: String,
    title: String,
    body: String,
    base_ref_name: String,
    head_ref_name: String,
}

#[derive(Deserialize, Debug, Clone)]
struct Stack {
    number: u64,
    size: u64,
}

#[derive(Deserialize, Debug)]
struct BasePr {
    number: u64,
    stack: Option<Stack>,
}

#[derive(Deserialize, Debug)]
struct Nodes<T> {
    nodes: Vec<T>,
}

#[derive(Deserialize, Debug)]
struct RepoPrs {
    /// Open PRs whose head is our head bookmark.
    head: Nodes<Pr>,
    /// Open PRs whose head is our base bookmark (to find the GitHub stack to append to).
    base: Nodes<BasePr>,
}

/// One round trip: open PRs for both the head and the base branch.
fn lookup_prs(git_dir: &Path, remote: &Remote, head: &str, base: &str) -> Result<RepoPrs> {
    let query = "query($owner:String!,$repo:String!,$head:String!,$base:String!){\
        repository(owner:$owner,name:$repo){\
          head: pullRequests(headRefName:$head, states:OPEN, first:10){\
            nodes { number url title body baseRefName headRefName } }\
          base: pullRequests(headRefName:$base, states:OPEN, first:10){\
            nodes { number stack { number size } } } } }";
    let out = gh(
        git_dir,
        &[
            "api",
            "graphql",
            "-f",
            &format!("query={query}"),
            "-f",
            &format!("owner={}", remote.owner),
            "-f",
            &format!("repo={}", remote.repo),
            "-f",
            &format!("head={head}"),
            "-f",
            &format!("base={base}"),
            "-q",
            ".data.repository",
        ],
    )?;
    Ok(serde_json::from_str(&out)?)
}

fn pr_number_from_url(url: &str) -> Result<u64> {
    url.trim_end_matches('/')
        .rsplit('/')
        .next()
        .and_then(|n| n.parse().ok())
        .with_context(|| format!("could not parse PR number from {url:?}"))
}

fn find_template(workspace_root: &Path) -> Option<PathBuf> {
    for dir in ["", ".github", "docs"] {
        let Ok(entries) = fs::read_dir(workspace_root.join(dir)) else {
            continue;
        };
        for entry in entries.flatten() {
            let name = entry.file_name();
            let name = name.to_string_lossy();
            if name.eq_ignore_ascii_case("pull_request_template.md") {
                return Some(entry.path());
            }
        }
    }
    None
}

fn edit_in_editor(editor: &str, initial: &str, help: &str) -> Result<Option<(String, String)>> {
    let path = env::temp_dir().join(format!("jj_pr_{}.md", std::process::id()));
    fs::write(&path, format!("{initial}\n{SCISSORS}\n{help}"))?;

    let status = Command::new(editor)
        .arg(&path)
        .stdin(Stdio::inherit())
        .stdout(Stdio::inherit())
        .stderr(Stdio::inherit())
        .status()
        .with_context(|| format!("failed to launch editor {editor:?}"))?;
    let edited = fs::read_to_string(&path)?;
    let _ = fs::remove_file(&path);
    if !status.success() {
        eprintln!("editor exited with {status}; aborting");
        return Ok(None);
    }

    let content = edited.split(SCISSORS).next().unwrap_or("");
    let mut it = content.splitn(2, '\n');
    let title = it.next().unwrap_or("").trim().to_string();
    let body = it.next().unwrap_or("").trim().to_string();
    if title.is_empty() {
        eprintln!("empty title; aborting");
        return Ok(None);
    }
    Ok(Some((title, body)))
}

fn main() {
    if let Err(e) = real_main() {
        eprintln!("error: {e:#}");
        std::process::exit(1);
    }
}

fn real_main() -> Result<()> {
    let args = Args::parse();

    // First jj call: snapshots the working copy and loads everything we need about the commits.
    let revs = load_revs(&args.revision)?;
    let head_rev = revs
        .iter()
        .find(|r| r.role == Role::Head)
        .expect("validated");
    let base_rev = revs
        .iter()
        .find(|r| r.role == Role::Base)
        .expect("validated");

    let git_dir = PathBuf::from(jj(&["git", "root"])?.trim());
    let workspace_root = PathBuf::from(jj(&["workspace", "root"])?.trim());

    let head = head_bookmark(head_rev)?;
    let base = pick_bookmark("base revision", &base_rev.local_bookmarks)?;
    ensure!(head != base, "head and base are both {head}");
    eprintln!("head: {head}\nbase: {base}");

    let remote = git_remote()?;
    ensure_pushed(head_rev, &head, base_rev, &base, &remote.name)?;

    let prs = lookup_prs(&git_dir, &remote, &head, &base)?;
    let existing = &prs.head.nodes;
    let same_base = existing
        .iter()
        .find(|pr| pr.base_ref_name == base && pr.head_ref_name == head);
    if let (None, Some(pr)) = (same_base, existing.first()) {
        bail!(
            "open PR #{} ({}) already has head {head} but base {:?} (wanted {base:?}); not touching it",
            pr.number,
            pr.url,
            pr.base_ref_name
        );
    }

    // When creating: if the base branch's own PR is part of a GitHub stack, append the new PR to it.
    let base_stack = match same_base {
        Some(_) => None,
        None => {
            let mut base_prs = prs.base.nodes.iter();
            let base_pr = base_prs.next();
            if let (Some(first), Some(_)) = (base_pr, base_prs.next()) {
                eprintln!(
                    "note: several open PRs have head {base}; using #{}",
                    first.number
                );
            }
            match base_pr {
                Some(BasePr {
                    number,
                    stack: Some(stack),
                }) => {
                    eprintln!(
                        "base PR #{number} is in stack #{} (size {}); will append",
                        stack.number, stack.size
                    );
                    Some(stack.clone())
                }
                Some(BasePr {
                    number,
                    stack: None,
                }) => {
                    eprintln!("base PR #{number} is not in a GitHub stack; not linking");
                    None
                }
                None => None,
            }
        }
    };

    let help = match same_base {
        Some(pr) => format!("# Editing PR #{} ({})\n", pr.number, pr.url),
        None => format!(
            "# Creating PR: {head} -> {base}{}{}\n",
            if args.draft { " (draft)" } else { "" },
            match &base_stack {
                Some(stack) => format!(", appended to stack #{}", stack.number),
                None => String::new(),
            }
        ),
    };
    let help = format!(
        "{help}# First line is the title, the rest (after a blank line) is the body.\n\
         # Everything from the scissors line down is discarded. Exit non-zero (:cq) to abort.\n"
    );

    let initial = match same_base {
        Some(pr) => format!("{}\n\n{}\n", pr.title, pr.body),
        None => {
            let template = match find_template(&workspace_root) {
                Some(p) => {
                    fs::read_to_string(&p).with_context(|| format!("reading {}", p.display()))?
                }
                None => String::new(),
            };
            // Commits in the PR, oldest first (log order is children-first, so reverse it).
            let in_pr: Vec<&Rev> = revs.iter().rev().filter(|r| r.role != Role::Base).collect();
            let (title, prelude) = if in_pr.len() == 1 {
                (head_rev.title().to_string(), head_rev.body().to_string())
            } else {
                (
                    String::new(),
                    in_pr
                        .iter()
                        .map(|r| format!("- {}", r.title()))
                        .collect::<Vec<_>>()
                        .join("\n"),
                )
            };
            let body = [prelude.as_str(), template.trim()]
                .into_iter()
                .filter(|s| !s.is_empty())
                .collect::<Vec<_>>()
                .join("\n\n");
            format!("{title}\n\n{body}\n")
        }
    };

    let Some((title, body)) = edit_in_editor(&args.editor, &initial, &help)? else {
        std::process::exit(1);
    };

    let body_path = env::temp_dir().join(format!("jj_pr_body_{}.md", std::process::id()));
    fs::write(&body_path, &body)?;
    let body_file: &OsStr = body_path.as_os_str();
    let body_file = body_file.to_str().context("temp path is not utf-8")?;

    let result = match same_base {
        Some(pr) => {
            let number = pr.number.to_string();
            gh(
                &git_dir,
                &[
                    "pr",
                    "edit",
                    &number,
                    "--title",
                    &title,
                    "--body-file",
                    body_file,
                ],
            )
            .map(|_| pr.url.clone())
        }
        None => {
            let mut argv = vec![
                "pr",
                "create",
                "--head",
                &head,
                "--base",
                &base,
                "--title",
                &title,
                "--body-file",
                body_file,
            ];
            if args.draft {
                argv.push("--draft");
            }
            gh(&git_dir, &argv).map(|out| out.trim().to_string())
        }
    };
    let _ = fs::remove_file(&body_path);
    let url = result?;
    println!("{url}");

    if let Some(stack) = base_stack {
        let pr_number = pr_number_from_url(&url)?;
        run(Command::new("gh")
            .env("GIT_DIR", &git_dir)
            .args([
                "stack",
                "link",
                &stack.number.to_string(),
                &pr_number.to_string(),
            ])
            .stdout(Stdio::inherit()))?;
        eprintln!("linked PR #{pr_number} onto stack #{}", stack.number);
    }
    Ok(())
}
